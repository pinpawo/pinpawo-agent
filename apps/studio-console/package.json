{
  "name": "@pinpawo/studio-console",
  "version": "0.1.0",
  "private": true,
  "description": "Independent browser console for PinPawo Studio APIs",
  "type": "module",
  "scripts": {
    "test": "tsx --tsconfig tsconfig.app.json --test tests/*.test.tsx",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false && tsc --noEmit -p tsconfig.browser.json",
    "test:browser": "node tests/channel.browser.mjs",
    "test:browser:knowledge": "node tests/knowledge.browser.mjs",
    "test:browser:layout": "node tests/channelLayout.browser.mjs",
    "test:browser:scheduler": "node tests/scheduler.browser.mjs",
    "test:browser:message": "node tests/channelMessage.browser.mjs",
    "test:browser:session": "node tests/petSession.browser.mjs"
  },
  "dependencies": {
    "@pinpawo/agent-session": "^1.0.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-hard-break": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "lucide-react": "^1.57.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
