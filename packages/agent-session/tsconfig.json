{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@pinpawo/pet-agent": [
        "../pet-agent/src/index.ts"
      ],
      "@pinpawo/pet-agent/protocol-validation": [
        "../pet-agent/src/protocolValidation.ts"
      ]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"]
}
