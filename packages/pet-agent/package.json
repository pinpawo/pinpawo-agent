{
  "name": "@pinpawo/pet-agent",
  "version": "0.2.1",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./protocol-validation": {
      "types": "./dist/protocolValidation.d.ts",
      "import": "./dist/protocolValidation.js",
      "default": "./dist/protocolValidation.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/protocolValidation.ts --format esm --dts --clean --out-dir dist --platform node --target node24",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit && npm run typecheck:evals",
    "typecheck:evals": "tsc -p tsconfig.evals.json --noEmit",
    "test": "node --import tsx/esm --test $(find src evals -name '*.test.ts' | sort)",
    "eval:dataset": "node --env-file=.env --import tsx/esm evals/dataset.ts",
    "eval:langfuse:sync-datasets": "node --env-file=.env --import tsx/esm evals/scripts/sync-langfuse-datasets.ts",
    "eval:langfuse:route": "node --env-file=.env --import tsx/esm evals/scripts/run-langfuse-route.eval.ts",
    "eval:langfuse:capability-planning": "node --env-file-if-exists=.env --import tsx/esm evals/scripts/run-langfuse-capability-planning.eval.ts",
    "eval:langfuse:outcome-decision": "node --env-file-if-exists=.env --import tsx/esm evals/scripts/run-langfuse-outcome-decision.eval.ts",
    "eval:langfuse:multi-task-flow": "node --env-file-if-exists=.env --import tsx/esm evals/scripts/run-langfuse-multi-task-flow.eval.ts",
    "eval:langfuse:tool-review-reject": "node --env-file=.env --import tsx/esm evals/scripts/run-langfuse-tool-review-reject.eval.ts",
    "eval:route": "node --env-file=.env --import tsx/esm evals/orchestrator-route.eval.ts",
    "eval:flow:mock-subagent": "node --env-file=.env --import tsx/esm evals/orchestrator-flow.mock-subagent.eval.ts",
    "eval:subagent": "node --env-file=.env --import tsx/esm evals/subagent.eval.ts",
    "eval:entry-decision": "node --env-file-if-exists=.env --import tsx/esm evals/entry-decision.eval.ts",
    "eval:decision-stability": "PROMPT_EVAL_DEFAULT_TARGETS=entry,outcome node --env-file-if-exists=.env --import tsx/esm evals/scripts/run-decision-stability.eval.ts",
    "eval:prompt-v1": "PROMPT_EVAL_TARGETS=entry,outcome,answer PROMPT_EVAL_REPEATS=3 node --env-file-if-exists=.env --import tsx/esm evals/scripts/run-decision-stability.eval.ts",
    "eval:prompt-stability": "node --env-file-if-exists=.env --import tsx/esm evals/scripts/run-decision-stability.eval.ts",
    "eval:prompt-matrix": "node --env-file-if-exists=.env --import tsx/esm evals/scripts/run-prompt-matrix.eval.ts",
    "eval:prompt-compare": "node --import tsx/esm evals/scripts/compare-prompt-stability.eval.ts",
    "eval:lifecycle-composition": "node --env-file-if-exists=.env --import tsx/esm evals/scripts/run-lifecycle-composition.eval.ts",
    "prompt:preview": "node --import tsx/esm evals/scripts/preview-decision-prompts.ts",
    "eval:structured-output": "LANGCHAIN_TRACING_V2=false node --env-file=.env --import tsx/esm evals/structured-output-compat.eval.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "langchain": "^1.5.2",
    "yaml": "^2.9.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@langchain/openai": "^1.5.3",
    "@types/node": "^24.0.0",
    "langsmith": "^0.5.21",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
