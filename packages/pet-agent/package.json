{
  "name": "@pinpawo/pet-agent",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && npm run typecheck:evals",
    "typecheck:evals": "tsc -p tsconfig.evals.json --noEmit",
    "test": "node --import tsx/esm --test $(find src evals -name '*.test.ts' | sort)",
    "eval:dataset": "node --env-file=.env --import tsx/esm evals/dataset.ts",
    "eval:langfuse:sync-datasets": "node --env-file=.env --import tsx/esm evals/scripts/sync-langfuse-datasets.ts",
    "eval:langfuse:route": "node --env-file=.env --import tsx/esm evals/scripts/run-langfuse-route.eval.ts",
    "eval:langfuse:capability-decision": "node --env-file=.env --import tsx/esm evals/scripts/run-langfuse-capability-decision.eval.ts",
    "eval:langfuse:outcome-decision": "node --env-file=.env --import tsx/esm evals/scripts/run-langfuse-outcome-decision.eval.ts",
    "eval:langfuse:capability-planning": "node --env-file=.env --import tsx/esm evals/scripts/run-langfuse-capability-planning.eval.ts",
    "eval:langfuse:multi-task-flow": "node --env-file=.env --import tsx/esm evals/scripts/run-langfuse-multi-task-flow.eval.ts",
    "eval:langfuse:tool-review-reject": "node --env-file=.env --import tsx/esm evals/scripts/run-langfuse-tool-review-reject.eval.ts",
    "eval:route": "node --env-file=.env --import tsx/esm evals/orchestrator-route.eval.ts",
    "eval:flow:mock-subagent": "node --env-file=.env --import tsx/esm evals/orchestrator-flow.mock-subagent.eval.ts",
    "eval:subagent": "node --env-file=.env --import tsx/esm evals/subagent.eval.ts",
    "eval:task-decision": "node --env-file-if-exists=.env --import tsx/esm evals/task-decision.eval.ts",
    "eval:structured-output": "LANGCHAIN_TRACING_V2=false node --env-file=.env --import tsx/esm evals/structured-output-compat.eval.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "langchain": "^1.5.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@langchain/openai": "^1.5.3",
    "@types/node": "^22.0.0",
    "langsmith": "^0.5.21",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
