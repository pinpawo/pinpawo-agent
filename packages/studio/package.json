{
  "name": "@pinpawo/studio-core",
  "version": "1.0.0",
  "description": "Independent PinPawo Studio Host, runtime and extension contracts",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "templates/default/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "pack:dry": "npm run build && npm pack --dry-run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "node --import ../../tests/support/isolateSessions.mjs --import tsx/esm --test $(find src -name '*.test.ts' | sort)"
  },
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@pinpawo/agent-contracts": "^1.0.0",
    "@pinpawo/pet-agent": "^1.0.1",
    "kysely": "^0.29.6",
    "mqemitter": "^7.1.0",
    "pg": "^8.23.1",
    "pinpawo": "^1.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "zod": "^3.22.0"
  }
}
