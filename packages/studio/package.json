{
  "name": "@pinpawo/studio",
  "version": "0.1.0",
  "description": "Independent PinPawo Studio Host, runtime, transports, and CLI",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "pinpawo-studio": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cliEntry.ts",
    "pack:dry": "npm run build && npm pack --dry-run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "start": "node dist/cli.js",
    "test:install": "npm run build -w @pinpawo/agent-contracts && npm run build -w @pinpawo/pet-agent && npm run build -w pinpawo && npm run build && node --import tsx/esm scripts/install-smoke.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test $(find src -name '*.test.ts' | sort)"
  },
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@pinpawo/agent-contracts": "^0.2.1",
    "@pinpawo/pet-agent": "^0.2.1",
    "pinpawo": "^0.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "zod": "^3.22.0"
  }
}
