{
  "studioId": "studio",
  "entryPetId": "executor",
  "pets": ["executor", "reviewer", "wiki"],
  "plugins": [
    {
      "id": "@pinpawo-plugin/studio-http",
      "options": {
        "port": 3211,
        "allowedOrigins": [
          "http://127.0.0.1:5173",
          "http://localhost:5173",
          "http://127.0.0.1:5176"
        ]
      }
    },
    {
      "id": "@pinpawo-plugin/notice",
      "options": {
        "rules": [
          {
            "noticeId": "dispatch-queues-attention",
            "title": "Dispatch queues need attention",
            "level": "warning",
            "source": {
              "kind": "studio_event",
              "eventSource": "scheduler",
              "type": "dispatch.queues_attention_required"
            }
          }
        ]
      }
    },
    { "id": "@pinpawo-plugin/channel" },
    {
      "id": "@pinpawo-plugin/scheduler",
      "options": {
        "dispatchQueueAudit": {
          "intervalMs": 600000,
          "attentionStates": ["waiting", "blocked"]
        }
      }
    },
    { "id": "@pinpawo-plugin/project-files" },
    {
      "id": "@pinpawo-plugin/trigger",
      "options": {
        "triggers": [
          {
            "triggerId": "external-request",
            "petId": "executor",
            "request": "Handle the following external request. Return the result with evidence.",
            "source": {
              "kind": "http",
              "secretEnv": "PINPAWO_STUDIO_TRIGGER_SECRET"
            }
          }
        ]
      }
    }
  ]
}
