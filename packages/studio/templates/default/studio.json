{
  "studioId": "studio",
  "entryPetId": "planner",
  "pets": ["planner", "executor", "reviewer", "wiki"],
  "plugins": [
    {
      "id": "@pinpawo-plugin/studio-http",
      "options": {
        "port": 3211,
        "allowedOrigins": [
          "http://127.0.0.1:5173",
          "http://localhost:5173",
          "http://127.0.0.1:5176"
        ]
      }
    },
    {
      "id": "@pinpawo-plugin/notice",
      "options": {
        "rules": [
          {
            "noticeId": "dispatch-queues-attention",
            "title": "Dispatch queues need attention",
            "level": "warning",
            "source": {
              "kind": "studio_event",
              "eventSource": "scheduler",
              "type": "dispatch.queues_attention_required"
            }
          }
        ]
      }
    },
    { "id": "@pinpawo-plugin/kanban" },
    {
      "id": "@pinpawo-plugin/scheduler",
      "options": {
        "dispatchQueueAudit": {
          "intervalMs": 600000,
          "attentionStates": ["waiting", "blocked"]
        }
      }
    },
    { "id": "@pinpawo-plugin/project-files" },
    {
      "id": "@pinpawo-plugin/trigger",
      "options": {
        "triggers": [
          {
            "triggerId": "external-request",
            "petId": "planner",
            "request": "Plan the following external request with Kanban.",
            "source": {
              "kind": "http",
              "secretEnv": "PINPAWO_STUDIO_TRIGGER_SECRET"
            }
          },
          {
            "triggerId": "wiki-on-task-done",
            "petId": "wiki",
            "request": {
              "template": "Reconcile project knowledge after {{event.type}} for task {{payload.taskId}}.",
              "context": [
                "payload.taskId",
                "payload.petId",
                "payload.note",
                "payload.sequence",
                "event.occurredAt"
              ]
            },
            "source": {
              "kind": "studio_event",
              "eventSource": "kanban",
              "type": "task.done"
            }
          },
          {
            "triggerId": "dispatch-assigned-kanban-task",
            "target": {
              "kind": "event_payload",
              "path": "payload.assigneeId",
              "allowedPetIds": ["executor", "reviewer"]
            },
            "request": {
              "template": "You were assigned Kanban task {{payload.taskId}}.\n\nTitle: {{payload.title}}\n\n{{payload.detail}}\n\nBefore work, call kanban_task_start with this taskId. Then report completion or a block with the same taskId.",
              "context": ["payload.taskId", "payload.title", "payload.detail", "payload.assignmentNote"]
            },
            "source": {
              "kind": "studio_event",
              "eventSource": "kanban",
              "type": "task.assigned"
            }
          }
        ]
      }
    }
  ]
}
