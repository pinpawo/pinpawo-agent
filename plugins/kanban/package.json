{
  "name": "@pinpawo-plugin/kanban",
  "version": "0.1.0",
  "description": "Studio task lifecycle Plugin and Agent Toolkit for assignment, dependencies, and shared progress",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test $(find src -name '*.test.ts' | sort)"
  },
  "dependencies": {
    "@langchain/core": "^1.2.1",
    "@pinpawo/pet-agent": "^0.2.1",
    "@pinpawo/studio": "^0.1.0",
    "zod": "^3.22.0"
  },
  "peerDependencies": {
    "@pinpawo-plugin/studio-http": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@pinpawo-plugin/studio-http": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pinpawo-plugin/studio-http": "^0.1.0",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
