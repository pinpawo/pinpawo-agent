{
  "name": "@pinpawo-plugin/notice",
  "version": "0.1.0",
  "description": "Durable Studio notice projection Plugin for PinPawo Studio",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=24" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist/"],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test $(find src -name '*.test.ts' | sort)"
  },
  "dependencies": { "@pinpawo/studio": "^0.1.0" },
  "peerDependencies": { "@pinpawo-plugin/studio-http": "^0.1.0" },
  "peerDependenciesMeta": {
    "@pinpawo-plugin/studio-http": { "optional": true }
  },
  "devDependencies": {
    "@pinpawo-plugin/studio-http": "^0.1.0",
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
