# Model profiles, including credentials and endpoints, are stored under "models"
# in ~/.pinpawo/config.json. They are not read from environment variables.
# Optional. Rerun the same structured-output LLM call after a parse/schema
# failure. Disabled by default. Set to true/1 to enable.
LLM_STRUCTURED_OUTPUT_AUTO_REPAIR=
# Optional. Additional repair retries after the initial structured-output call.
# Defaults to 1 when auto repair is enabled; capped at 3.
LLM_STRUCTURED_OUTPUT_REPAIR_MAX_RETRIES=

# Shell and CDP browser instances are configured in ~/.pinpawo/runtime/config.json.
# Optional. Use another directory for shared Runtime configuration and service state.
# PINPAWO_RUNTIME_DIR=/absolute/path/to/runtime
