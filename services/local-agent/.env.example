# Fill in these values manually; they are read together with
# ~/.pinpawo/config.json.

# LLM (OpenAI-compatible)
LLM_API_KEY=sk-xxx
# Presets: gpt-5, claude-sonnet, qwen, minimax, glm, kimi-code, kimi, deepseek, gemini.
LLM_MODEL_PRESET=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-max
# Optional. If omitted, the agent will infer this from LLM_MODEL when possible.
# For custom or unknown models, fill in the exact context window manually.
LLM_CONTEXT_WINDOW_TOKENS=
# Optional. Rerun the same structured-output LLM call after a parse/schema
# failure. Disabled by default. Set to true/1 to enable.
LLM_STRUCTURED_OUTPUT_AUTO_REPAIR=
# Optional. Additional repair retries after the initial structured-output call.
# Defaults to 1 when auto repair is enabled; capped at 3.
LLM_STRUCTURED_OUTPUT_REPAIR_MAX_RETRIES=

# Browser backend: auto (connected extension first, otherwise Playwright), playwright, or extension.
# Extension setup: build @pinpawo-toolkit/browser, load its generated extension in Chrome,
# then run: pinpawo browser extension register --extension-id <id>
PINPAWO_BROWSER_BACKEND=auto
