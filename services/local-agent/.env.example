# Run "npx tsx src/index.ts login" to set these automatically.
# Or fill in manually:

# Server
# Set PINPAWO_LOCAL_ONLY=1 to force local-only startup even if saved
# server credentials exist in ~/.pinpawo/config.json.
PINPAWO_LOCAL_ONLY=
API_BASE_URL=https://your-api.example.com
HASURA_ENDPOINT=https://your-hasura.example.com/v1/graphql
AGENT_TOKEN=your-agent-token-here
HASURA_JWT=eyJ...

# LLM (OpenAI-compatible)
LLM_API_KEY=sk-xxx
# Presets: gpt-5, claude-sonnet, qwen, minimax, glm, kimi-code, kimi, deepseek, gemini.
LLM_MODEL_PRESET=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-max
# Optional. If omitted, the agent will infer this from LLM_MODEL when possible.
# For custom or unknown models, fill in the exact context window manually.
LLM_CONTEXT_WINDOW_TOKENS=
# Optional. Rerun the same structured-output LLM call after a parse/schema
# failure. Disabled by default. Set to true/1 to enable.
LLM_STRUCTURED_OUTPUT_AUTO_REPAIR=
# Optional. Additional repair retries after the initial structured-output call.
# Defaults to 1 when auto repair is enabled; capped at 3.
LLM_STRUCTURED_OUTPUT_REPAIR_MAX_RETRIES=

# Timing (optional)
POLL_INTERVAL_SECONDS=60

# Browser backend: auto (Playwright detection), playwright, or extension.
# Extension setup: build tools/chrome-extension, load it unpacked in Chrome,
# then run: pinpawo-agent browser extension register --extension-id <id>
PINPAWO_BROWSER_BACKEND=auto
