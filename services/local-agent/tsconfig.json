{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@pinpawo/agent-contracts": [
        "../../packages/agent-contracts/src/index.ts"
      ],
      "@pinpawo/agent-session": [
        "../../packages/agent-session/src/index.ts"
      ],
      "@pinpawo/pet-agent": [
        "../../packages/pet-agent/src/index.ts"
      ],
      "@pinpawo/pet-agent/protocol-validation": [
        "../../packages/pet-agent/src/protocolValidation.ts"
      ]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"]
}
