{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@pinpawo/agent-contracts": [
        "../../packages/agent-contracts/src/index.ts"
      ],
      "@pinpawo/agent-session": [
        "../../packages/agent-session/src/index.ts"
      ],
      "@pinpawo/pet-agent": [
        "../../packages/pet-agent/src/index.ts"
      ],
      "pinpawo/host-runtime": [
        "../../services/host/src/hostRuntime.ts"
      ],
      "pinpawo/wire": [
        "../../services/host/src/wire/index.ts"
      ],
      "@pinpawo/studio-core": [
        "../../packages/studio/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "scripts",
    "tsup.config.ts"
  ]
}
