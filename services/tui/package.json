{
  "name": "@pinpawo/tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build:spike": "bun build --compile src/spike.ts --outfile dist/pinpawo-tui-spike",
    "dev": "bun run src/spike.ts",
    "dev:split": "bun run src/splitFooterSpike.ts",
    "smoke": "bun run src/spike.ts --smoke",
    "smoke:split": "bun run src/splitFooterSpike.ts --smoke",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test $(find src -name '*.test.ts' | sort)"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@pinpawo/agent-session": "*",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
