{
  "name": "@pinpawo-tests/agent-evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repository-level Agent evals: real-model and scripted evaluations of pet-agent behavior, using Host model profiles and Toolkits.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test $(find src -name '*.test.ts' | sort)",
    "eval:dataset": "node --env-file=.env --import tsx/esm src/dataset.ts",
    "eval:langfuse:sync-datasets": "node --env-file=.env --import tsx/esm src/scripts/sync-langfuse-datasets.ts",
    "eval:langfuse:route": "node --env-file=.env --import tsx/esm src/scripts/run-langfuse-route.eval.ts",
    "eval:langfuse:capability-planning": "node --env-file-if-exists=.env --import tsx/esm src/scripts/run-langfuse-capability-planning.eval.ts",
    "eval:langfuse:multi-task-flow": "node --env-file-if-exists=.env --import tsx/esm src/scripts/run-langfuse-multi-task-flow.eval.ts",
    "eval:langfuse:tool-review-reject": "node --env-file=.env --import tsx/esm src/scripts/run-langfuse-tool-review-reject.eval.ts",
    "eval:route": "node --env-file=.env --import tsx/esm src/orchestrator-route.eval.ts",
    "eval:flow:mock-subagent": "node --env-file=.env --import tsx/esm src/orchestrator-flow.mock-subagent.eval.ts",
    "eval:supervisor-details": "LANGCHAIN_TRACING_V2=false LANGSMITH_TRACING=false node --import tsx/esm src/supervisor-details.eval.ts",
    "eval:supervisor-delivery-closure": "LANGCHAIN_TRACING_V2=false LANGSMITH_TRACING=false node --import tsx/esm src/supervisor-delivery-closure.eval.ts",
    "eval:supervisor-tool-history": "LANGCHAIN_TRACING_V2=false LANGSMITH_TRACING=false node --import tsx/esm src/supervisor-tool-history.eval.ts",
    "eval:supervisor-boundary": "LANGCHAIN_TRACING_V2=false LANGSMITH_TRACING=false node --import tsx/esm src/supervisor-boundary.eval.ts",
    "eval:supervisor-plan-adjustment": "LANGCHAIN_TRACING_V2=false LANGSMITH_TRACING=false node --import tsx/esm src/supervisor-plan-adjustment.eval.ts",
    "eval:subagent": "node --env-file-if-exists=.env --import tsx/esm src/subagent.eval.ts",
    "eval:langfuse:subagent": "node --env-file-if-exists=.env --import tsx/esm src/subagent.eval.ts",
    "eval:entry-answer": "PROMPT_EVAL_DEFAULT_TARGETS=entry_answer node --env-file-if-exists=.env --import tsx/esm src/scripts/run-decision-stability.eval.ts",
    "eval:decision-stability": "PROMPT_EVAL_DEFAULT_TARGETS=entry_answer node --env-file-if-exists=.env --import tsx/esm src/scripts/run-decision-stability.eval.ts",
    "eval:prompt-v1": "PROMPT_EVAL_TARGETS=entry_answer PROMPT_EVAL_REPEATS=3 node --env-file-if-exists=.env --import tsx/esm src/scripts/run-decision-stability.eval.ts",
    "eval:prompt-stability": "node --env-file-if-exists=.env --import tsx/esm src/scripts/run-decision-stability.eval.ts",
    "eval:prompt-matrix": "node --env-file-if-exists=.env --import tsx/esm src/scripts/run-prompt-matrix.eval.ts",
    "eval:prompt-compare": "node --import tsx/esm src/scripts/compare-prompt-stability.eval.ts",
    "eval:lifecycle-composition": "node --env-file-if-exists=.env --import tsx/esm src/scripts/run-lifecycle-composition.eval.ts",
    "eval:auto-review-risk": "node --env-file-if-exists=.env --import tsx/esm src/auto-review-risk.eval.ts",
    "prompt:preview": "node --import tsx/esm src/scripts/preview-decision-prompts.ts",
    "supervisor:context-audit": "node --import tsx/esm src/scripts/audit-run-supervisor-context.ts",
    "eval:structured-output": "LANGCHAIN_TRACING_V2=false node --env-file=.env --import tsx/esm src/structured-output-compat.eval.ts"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/openai": "^1.5.3",
    "@langfuse/client": "^5.10.0",
    "@langfuse/otel": "^5.10.0",
    "@langfuse/tracing": "^5.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@pinpawo/pet-agent": "*",
    "@types/node": "^24.0.0",
    "langchain": "^1.5.2",
    "langsmith": "^0.5.21",
    "pinpawo": "*",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "zod": "^3.22.0"
  }
}
