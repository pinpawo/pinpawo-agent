{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@pinpawo/pet-agent": ["../../packages/pet-agent/src/index.ts"],
      "@pinpawo/studio": ["../../packages/studio/src/index.ts"],
      "@pinpawo-plugin/studio-http": ["../../plugins/studio-http/src/index.ts"],
      "@pinpawo-plugin/channel": ["../../plugins/channel/src/index.ts"],
      "@pinpawo-plugin/notice": ["../../plugins/notice/src/index.ts"],
      "@pinpawo-plugin/project-files": ["../../plugins/project-files/src/index.ts"],
      "@pinpawo-plugin/scheduler": ["../../plugins/scheduler/src/index.ts"],
      "@pinpawo-plugin/trigger": ["../../plugins/trigger/src/index.ts"],
      "pinpawo/host-runtime": ["../../services/host/src/hostRuntime.ts"],
      "pinpawo/wire": ["../../services/host/src/wire/index.ts"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"]
}
