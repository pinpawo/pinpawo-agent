{
  "manifest_version": 3,
  "name": "PinPawo Browser Bridge",
  "version": "0.2.1",
  "minimum_chrome_version": "118",
  "description": "Lets the local PinPawo agent use the tabs in its PinPawo tab groups.",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PinPawo: drag a tab into a PinPawo group to hand it to that agent session",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
